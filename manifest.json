{
  "manifest_version": 3,
  "name": "FB 智能私信大师",
  "short_name": "FB Auto-Responder",
  "version": "1.6.0",
  "description": "全自动驻留专业面板【评论管理工具】全主页集中监控，高效私信意向用户，极致防封安全稳定。",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "assets/icon48.png",
    "default_title": "FB 智能私信大师 v1.6.0"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.messenger.com/*",
    "https://script.google.com/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*"
      ],
      "js": [
        "utils/storage.js",
        "content/comments_manager_scrub.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icon48.png"
      ],
      "matches": [
        "https://*.facebook.com/*"
      ]
    }
  ],
  "options_page": "dashboard/dashboard.html"
}